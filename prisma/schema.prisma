// ============================================================================
// Sistema de Gestion de TI - Schema Prisma (fuente de verdad)
// Motor: MySQL 8 | Prisma 7 (requiere driver adapter)
// La fuente de verdad es este archivo; db/schema.sql es referencia historica.
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum EstadoIncidencia {
  NUEVO
  EN_ANALISIS
  EN_CURSO
  COMPLETADO
  DUPLICADO
}

enum Prioridad {
  BAJA
  NORMAL
  ALTA
  CRITICA
}

enum TipoRequerimiento {
  NETSUITE
  OTROS
  OFFICE
  EMAIL
  IMPRESION
  ERROR_EN_EQUIPO
  SOLICITUD_DE_EQUIPO
  INTRANET
  CONEXION_DE_RED
}

enum EstadoActivo {
  EN_USO
  EN_ALMACEN
  EN_MANTENIMIENTO
  DE_BAJA
}

enum MantenimientoTipo {
  PREVENTIVO
  CORRECTIVO
}

enum MantenimientoEstado {
  PROGRAMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

enum MantenimientoPrioridad {
  BAJA
  MEDIA
  ALTA
}

enum PrioridadRecordatorio {
  BAJA
  MEDIA
  ALTA
}

enum AccionAuditoriaSecreto {
  CREAR
  ACTUALIZAR
  DESACTIVAR
  REVELAR
}

enum EntidadAdjunto {
  ACTIVO
  MANTENIMIENTO
  INCIDENCIA
  PROYECTO
}

enum EstadoProyecto {
  PLANIFICADO
  EN_PROGRESO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum RolProyecto {
  LIDER
  DESARROLLADOR
  QA
  STAKEHOLDER
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum EstadoHito {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum EstadoReporteGenerado {
  PENDIENTE
  GENERANDO
  COMPLETADO
  FALLIDO
}

enum TipoNotificacion {
  INCIDENCIA_NUEVA
  LICENCIA_POR_VENCER
}

// ------------------------------------------------------
// CATALOGOS
// ------------------------------------------------------

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  permisos Json
  activo   Boolean   @default(true)
  usuarios Usuario[]
}

model Departamento {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  activo      Boolean      @default(true)
  usuarios    Usuario[]
  incidencias Incidencia[]
  proyectos   Proyecto[]
}

model Ubicacion {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  activo   Boolean   @default(true)
  usuarios Usuario[]
}

model Puesto {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  activo   Boolean   @default(true)
  usuarios Usuario[]
}

model TipoUsuario {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  activo   Boolean   @default(true)
  usuarios Usuario[]
}

// ------------------------------------------------------
// USUARIOS
// ------------------------------------------------------

model Usuario {
  id          String    @id // Clave interna del excel (ej: "A006")
  nombre      String
  email       String? // Sin unique: hay correos compartidos entre usuarios
  activo      Boolean   @default(true)
  fechaInicio DateTime?
  fechaFin    DateTime?

  passwordHash String? @db.VarChar(100) // bcrypt; null = usuario sin acceso al sistema

  permisosExtra     Json? // Permisos adicionales sobre los del rol (overrides)
  permisosRevocados Json? // Permisos del rol revocados solo para este usuario

  departamentoId Int?
  ubicacionId    Int?
  puestoId       Int?
  tipoUsuarioId  Int?
  rolId          Int?

  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  ubicacion    Ubicacion?    @relation(fields: [ubicacionId], references: [id])
  puesto       Puesto?       @relation(fields: [puestoId], references: [id])
  tipoUsuario  TipoUsuario?  @relation(fields: [tipoUsuarioId], references: [id])
  rol          Rol?          @relation(fields: [rolId], references: [id])

  incidencias           Incidencia[]         @relation("Solicitante")
  incidenciasAsignadas  Incidencia[]         @relation("AsignadoA")
  activosResponsables   Activo[]             @relation("Responsable")
  asignaciones          AsignacionComputo[]
  mantenimientosTecnico OrdenMantenimiento[] @relation("TecnicoMantenimiento")
  licencias             Licencia[]
  notificaciones        Notificacion[]
  recordatorios         Recordatorio[]       @relation("Recordatorios")
  auditoriasSecretos    AuditoriaSecreto[]
  auditorias            Auditoria[]
  adjuntosSubidos       Adjunto[]            @relation("AdjuntosSubidos")
  proyectosResponsables Proyecto[]           @relation("ResponsableProyecto")
  proyectosMiembro      ProyectoMiembro[]    @relation("MiembrosProyecto")
  tareasProyecto        ProyectoTarea[]       @relation("TareasProyecto")
  registrosHorasProyecto ProyectoRegistroHoras[] @relation("HorasProyecto")
  reportesGenerados     ReporteGenerado[]      @relation("ReportesGenerados")
  reportesProgramados   ReporteProgramado[]    @relation("ReportesProgramados")

  @@index([email])
}

// ------------------------------------------------------
// INCIDENCIAS (TICKETS)
// ------------------------------------------------------

model Incidencia {
  id                Int               @id @default(autoincrement())
  originalId        Int?              @unique // ID original de SharePoint (reimportacion/desduplicado)
  titulo            String            @db.VarChar(500)
  descripcion       String            @db.Text
  fechaNotificacion DateTime          @default(now())
  fechaResolucion   DateTime?
  estado            EstadoIncidencia  @default(NUEVO)
  prioridad         Prioridad         @default(NORMAL)
  tipoRequerimiento TipoRequerimiento
  evidenciaUrl      String?           @db.VarChar(500)
  orden             Int               @default(0)

  solicitanteId  String // Obligatorio: siempre hay quien reporta
  asignadoAId    String?
  departamentoId Int?

  solicitante     Usuario                   @relation("Solicitante", fields: [solicitanteId], references: [id])
  asignadoA       Usuario?                  @relation("AsignadoA", fields: [asignadoAId], references: [id])
  departamento    Departamento?             @relation(fields: [departamentoId], references: [id])
  actualizaciones ActualizacionIncidencia[]
  notificaciones  Notificacion[]

  @@index([estado, fechaNotificacion])
  @@index([estado, orden])
  @@index([solicitanteId])
}

model ActualizacionIncidencia {
  id           Int      @id @default(autoincrement())
  incidenciaId Int
  texto        String   @db.Text
  creadaEn     DateTime @default(now())

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
}

model Notificacion {
  id           Int              @id @default(autoincrement())
  usuarioId    String
  tipo         TipoNotificacion @default(INCIDENCIA_NUEVA)
  incidenciaId Int?
  licenciaId   Int?
  hitoDias     Int?
  creadaEn     DateTime         @default(now())
  leidaEn      DateTime?

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  incidencia Incidencia? @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  licencia   Licencia?   @relation(fields: [licenciaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, incidenciaId])
  @@unique([usuarioId, licenciaId, hitoDias])
  @@index([usuarioId, leidaEn, creadaEn])
  @@index([incidenciaId])
  @@index([licenciaId])
}

// ------------------------------------------------------
// INVENTARIO DE EQUIPOS
// ------------------------------------------------------

model Activo {
  id            Int          @id @default(autoincrement())
  claveActivo   String?      @unique // AF00007 (algunos renglones del Excel no traen clave)
  cb23          String?
  tipo          String // Laptop, Desktop, Mini PC, Monitor...
  marca         String?
  modelo        String?
  numeroParte   String?
  numeroSerie   String?
  sucursal      String?
  anydesk       String?
  nombreRed     String?
  procesador    String?
  memoria       String?
  estado        EstadoActivo @default(EN_USO)
  estadoGeneral String? // Condicion fisica (ej: "Bien")
  notas         String?      @db.Text

  responsableId String?
  responsable   Usuario? @relation("Responsable", fields: [responsableId], references: [id])

  asignaciones   AsignacionComputo[]
  mantenimientos OrdenMantenimiento[]
}

model AsignacionComputo {
  id              Int       @id @default(autoincrement())
  usuarioId       String
  activoId        Int
  anioCompra      Int?
  numeroActivo    String?
  nombreEquipo    String? // Hostname del equipo
  bitlocker       String? // Clave de recuperacion (candidata a cifrado)
  observacion     String?   @db.Text
  activa          Boolean   @default(true)
  fechaAsignacion DateTime  @default(now())
  fechaDevolucion DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  activo  Activo  @relation(fields: [activoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, activoId])
}

// ------------------------------------------------------
// RECORDATORIOS
// ------------------------------------------------------

model Recordatorio {
  id           Int                   @id @default(autoincrement())
  titulo       String                @db.VarChar(200)
  descripcion  String?               @db.Text
  fecha        DateTime?
  prioridad    PrioridadRecordatorio @default(MEDIA)
  completado   Boolean               @default(false)
  completadoEn DateTime?
  activo       Boolean               @default(true)
  usuarioId    String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  usuario Usuario @relation("Recordatorios", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, activo, completado, fecha])
  @@index([fecha])
}

// ------------------------------------------------------
// ARCHIVOS ADJUNTOS
// ------------------------------------------------------

model Adjunto {
  id             Int            @id @default(autoincrement())
  entidadTipo    EntidadAdjunto
  entidadId      String         @db.VarChar(191)
  s3Bucket       String         @db.VarChar(191)
  s3Key          String         @unique @db.VarChar(512)
  nombreOriginal String         @db.VarChar(255)
  mimeType       String         @db.VarChar(127)
  extension      String         @db.VarChar(20)
  tamano         Int
  subidoPorId    String
  subidoEn       DateTime       @default(now())

  subidoPor Usuario @relation("AdjuntosSubidos", fields: [subidoPorId], references: [id], onDelete: Restrict)

  @@index([entidadTipo, entidadId, subidoEn])
  @@index([subidoPorId])
}

// ------------------------------------------------------
// PROYECTOS
// ------------------------------------------------------

model Proyecto {
  id                  Int            @id @default(autoincrement())
  codigo              String         @unique @db.VarChar(20)
  nombre              String         @db.VarChar(200)
  descripcion         String?        @db.Text
  estado              EstadoProyecto @default(PLANIFICADO)
  prioridad           Prioridad      @default(NORMAL)
  fechaInicio         DateTime
  fechaFinPlanificada DateTime
  fechaFinReal        DateTime?
  presupuesto         Decimal?       @db.Decimal(12, 2)
  responsableId       String
  departamentoId      Int?
  activo              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  responsable  Usuario       @relation("ResponsableProyecto", fields: [responsableId], references: [id])
  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  miembros      ProyectoMiembro[]
  tareas        ProyectoTarea[]
  hitos         ProyectoHito[]
  registrosHoras ProyectoRegistroHoras[]

  @@index([estado, fechaFinPlanificada])
  @@index([responsableId])
  @@index([departamentoId])
  @@index([activo])
}

model ProyectoMiembro {
  proyectoId Int
  usuarioId  String
  rol        RolProyecto @default(DESARROLLADOR)
  createdAt  DateTime    @default(now())

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation("MiembrosProyecto", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([proyectoId, usuarioId])
  @@index([usuarioId])
}

model ProyectoHito {
  id               Int         @id @default(autoincrement())
  proyectoId       Int
  titulo           String      @db.VarChar(200)
  descripcion      String?     @db.Text
  estado           EstadoHito  @default(PENDIENTE)
  fechaPlanificada DateTime
  fechaCompletada  DateTime?
  orden            Int         @default(0)
  activo           Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId, activo, fechaPlanificada])
}

model ProyectoTarea {
  id              Int          @id @default(autoincrement())
  proyectoId      Int
  parentId        Int?
  titulo          String       @db.VarChar(200)
  descripcion     String?      @db.Text
  estado          EstadoTarea  @default(PENDIENTE)
  prioridad       Prioridad    @default(NORMAL)
  asignadoAId     String?
  fechaInicio     DateTime?
  fechaVencimiento DateTime?
  fechaCompletada DateTime?
  orden           Int          @default(0)
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  proyecto    Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  parent       ProyectoTarea? @relation("Subtareas", fields: [parentId], references: [id], onDelete: Cascade)
  subtareas    ProyectoTarea[] @relation("Subtareas")
  asignadoA    Usuario?       @relation("TareasProyecto", fields: [asignadoAId], references: [id])
  dependencias  ProyectoTareaDependencia[] @relation("DependenciasTarea")
  dependientes  ProyectoTareaDependencia[] @relation("DependientesTarea")
  registrosHoras ProyectoRegistroHoras[]

  @@index([proyectoId, activo, orden])
  @@index([parentId])
  @@index([asignadoAId])
}

model ProyectoRegistroHoras {
  id          Int      @id @default(autoincrement())
  proyectoId  Int
  tareaId     Int?
  usuarioId   String
  fecha       DateTime
  horas       Decimal  @db.Decimal(6, 2)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proyecto Proyecto      @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tarea    ProyectoTarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  usuario  Usuario       @relation("HorasProyecto", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([proyectoId, activo, fecha])
  @@index([tareaId])
  @@index([usuarioId])
}

model ProyectoTareaDependencia {
  tareaId      Int
  dependeDeId  Int
  createdAt    DateTime @default(now())

  tarea      ProyectoTarea @relation("DependenciasTarea", fields: [tareaId], references: [id], onDelete: Cascade)
  dependeDe  ProyectoTarea @relation("DependientesTarea", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@id([tareaId, dependeDeId])
  @@index([dependeDeId])
}

// ------------------------------------------------------
// MANTENIMIENTO DE EQUIPOS
// ------------------------------------------------------

model OrdenMantenimiento {
  id                 Int                    @id @default(autoincrement())
  folio              String                 @unique
  activoId           Int
  tipo               MantenimientoTipo
  estado             MantenimientoEstado    @default(PROGRAMADO)
  estadoActivoPrevio EstadoActivo?
  prioridad          MantenimientoPrioridad @default(MEDIA)
  tecnicoId          String
  fechaProgramada    DateTime
  fechaRealizada     DateTime?
  costo              Decimal?               @db.Decimal(10, 2)
  descripcion        String?                @db.Text
  evidencias         Json? // DEPRECATED: usar Adjunto (entidadTipo MANTENIMIENTO)
  activo             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  activoRel Activo  @relation(fields: [activoId], references: [id])
  tecnico   Usuario @relation("TecnicoMantenimiento", fields: [tecnicoId], references: [id])

  @@index([activoId, fechaProgramada])
  @@index([estado])
  @@index([tecnicoId])
}

// ------------------------------------------------------
// LICENCIAS Y CREDENCIALES
// ------------------------------------------------------

model Licencia {
  id                      Int       @id @default(autoincrement())
  software                String
  clave                   String?   @db.Text // Cifrar con AES-256-GCM antes de guardar
  proveedor               String?
  fechaCompra             DateTime?
  fechaVencimiento        DateTime // Obligatoria: alimenta el cron de alertas
  activa                  Boolean   @default(true)
  asignadaAId             String?
  ultimaAlertaVencimiento DateTime?

  asignadaA      Usuario?       @relation(fields: [asignadaAId], references: [id])
  notificaciones Notificacion[]

  @@index([activa, fechaVencimiento])
  @@index([ultimaAlertaVencimiento])
}

model Secreto {
  id         Int     @id @default(autoincrement())
  tipo       String?
  proyecto   String?
  nombre     String?
  usuario    String?
  password   String  @db.Text // Cifrar con AES-256-GCM antes de guardar
  comentario String? @db.Text
  activo     Boolean @default(true)

  auditorias AuditoriaSecreto[]
}

model AuditoriaSecreto {
  id          Int                    @id @default(autoincrement())
  secretoId   Int
  usuarioId   String
  accion      AccionAuditoriaSecreto
  campos      Json?
  realizadaEn DateTime               @default(now())

  secreto Secreto @relation(fields: [secretoId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([secretoId, realizadaEn])
  @@index([usuarioId, realizadaEn])
}

model ReporteGenerado {
  id            Int                   @id @default(autoincrement())
  codigo        String                @db.VarChar(100)
  formato       String                @db.VarChar(10)
  parametros    Json?
  estado        EstadoReporteGenerado @default(PENDIENTE)
  s3Bucket      String?               @db.VarChar(191)
  s3Key         String?               @db.VarChar(512)
  nombreArchivo String?               @db.VarChar(255)
  tamano        Int?
  error         String?               @db.Text
  usuarioId     String
  reporteProgramadoId Int?
  creadoEn      DateTime              @default(now())
  iniciadoEn    DateTime?
  terminadoEn   DateTime?

  usuario            Usuario            @relation("ReportesGenerados", fields: [usuarioId], references: [id], onDelete: Restrict)
  reporteProgramado  ReporteProgramado?  @relation(fields: [reporteProgramadoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn])
  @@index([estado, creadoEn])
  @@index([reporteProgramadoId])
}

model ReporteProgramado {
  id               Int      @id @default(autoincrement())
  codigo           String   @db.VarChar(100)
  formato          String   @db.VarChar(10)
  parametros       Json?
  cron             String   @db.VarChar(100)
  destinatarios    Json
  activo           Boolean  @default(true)
  usuarioId        String
  ultimaEjecucion  DateTime?
  ultimoEstado     String?  @db.VarChar(20)
  ultimoError      String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usuario     Usuario           @relation("ReportesProgramados", fields: [usuarioId], references: [id], onDelete: Restrict)
  generaciones ReporteGenerado[]

  @@index([usuarioId, createdAt])
  @@index([activo, createdAt])
}

// ------------------------------------------------------
// AUDITORIA GLOBAL
// ------------------------------------------------------

model Auditoria {
  id          Int      @id @default(autoincrement())
  modulo      String   @db.VarChar(50)
  accion      String   @db.VarChar(50)
  entidadId   String?  @db.VarChar(191)
  usuarioId   String
  detalle     Json?
  realizadaEn DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([modulo, realizadaEn])
  @@index([usuarioId, realizadaEn])
  @@index([entidadId])
}
