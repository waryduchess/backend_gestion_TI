meta {
  name: Crear activo para prueba de borrado logico
  type: http
  seq: 35
}

script:pre-request {
  const clave = "AFLOG" + Date.now();
  bru.setEnvVar("claveActivoLog", clave);
}

post {
  url: {{baseUrl}}/api/activos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipo": "Dispositivo de prueba",
    "claveActivo": "{{claveActivoLog}}"
  }
}

script:post-response {
  bru.setEnvVar("activoParaEliminarId", res.body.data.id);
}

assert {
  res.status: eq 201
}
