meta {
  name: Crear activo para prueba de borrado logico
  type: http
  seq: 35
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  const clave = "AFLOG" + Date.now();
  bru.setEnvVar("claveActivoLog", clave);
}

post {
  url: {{baseUrl}}/api/activos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipo": "Dispositivo de prueba",
    "claveActivo": "{{claveActivoLog}}"
  }
}

script:post-response {
  bru.setEnvVar("activoParaEliminarId", res.body.data.id);
}

assert {
  res.status: eq 201
}
