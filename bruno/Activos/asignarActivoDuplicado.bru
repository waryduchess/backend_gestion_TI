meta {
  name: Asignar activo ya asignado
  type: http
  seq: 29
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}/asignaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuarioId": "A010"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.success: eq false
}

assert {
  res.body.message: eq El activo ya tiene una asignacion activa; devuelvelo antes de reasignarlo
}

assert {
  res.body.errors[1].campo: eq asignacionActiva
}
