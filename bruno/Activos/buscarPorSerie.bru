meta {
  name: Buscar activo por serie
  type: http
  seq: 3
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/activos?q=CXBF1Z3
  body: json
  auth: none
}

script:post-response {
  bru.setEnvVar("activoConAsignacionId", res.body.data[0].id);
}

assert {
  res.status: eq 200
}

assert {
  res.body.data[0].claveActivo: eq AF00010
}
