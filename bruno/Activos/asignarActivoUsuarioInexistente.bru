meta {
  name: Asignar activo a usuario inexistente
  type: http
  seq: 31
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}/asignaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuarioId": "ZZZZ99"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El usuario no existe
}

assert {
  res.body.errors[0].campo: eq usuarioId
}
