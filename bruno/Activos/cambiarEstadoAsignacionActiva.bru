meta {
  name: Cambiar estado con asignacion activa
  type: http
  seq: 27
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/activos/{{activoConAsignacionId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "DE_BAJA"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.success: eq false
}

assert {
  res.body.errors[0].campo: eq estado
}

assert {
  res.body.errors[1].campo: eq asignacionActiva
}
