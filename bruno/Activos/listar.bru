meta {
  name: Listar activos
  type: http
  seq: 1
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/activos?page=1&limit=5
  body: json
  auth: none
}

script:post-response {
  bru.setEnvVar("primerActivoId", res.body.data[0].id);
  bru.setEnvVar("totalActivos", res.body.meta.total);
}

assert {
  res.status: eq 200
}
