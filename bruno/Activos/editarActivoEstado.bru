meta {
  name: Editar activo con estado en el body
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "EN_ALMACEN"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}

assert {
  res.body.errors[0].campo: eq estado
}
