meta {
  name: Editar activo con estado en el body
  type: http
  seq: 16
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "EN_ALMACEN"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}

assert {
  res.body.errors[0].campo: eq estado
}
