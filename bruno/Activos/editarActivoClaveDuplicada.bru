meta {
  name: Editar activo con clave duplicada
  type: http
  seq: 19
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "claveActivo": "AF00010"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.message: eq Ya existe un activo con esa clave
}
