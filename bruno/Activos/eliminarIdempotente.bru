meta {
  name: Eliminar activo ya de baja (idempotente)
  type: http
  seq: 37
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

delete {
  url: {{baseUrl}}/api/activos/{{activoParaEliminarId}}
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.estado: eq DE_BAJA
}
