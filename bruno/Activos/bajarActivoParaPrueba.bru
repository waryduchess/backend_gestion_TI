meta {
  name: Dar de baja el activo de prueba
  type: http
  seq: 33
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/activos/{{activoParaBajaId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "DE_BAJA"
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.estado: eq DE_BAJA
}
