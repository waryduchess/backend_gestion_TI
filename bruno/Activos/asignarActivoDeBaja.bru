meta {
  name: Asignar activo dado de baja
  type: http
  seq: 34
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/activos/{{activoParaBajaId}}/asignaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuarioId": "A010"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.message: eq El activo esta dado de baja; no se puede asignar
}

assert {
  res.body.errors[0].campo: eq estado
}
