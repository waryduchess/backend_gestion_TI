meta {
  name: Cambiar estado con valor invalido
  type: http
  seq: 24
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "BOGUS"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq estado
}

assert {
  res.body.errors[0].permitidos[0]: eq EN_USO
}
