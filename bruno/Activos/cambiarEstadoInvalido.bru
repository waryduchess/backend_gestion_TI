meta {
  name: Cambiar estado con valor invalido
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/activos/{{ultimoActivoId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "BOGUS"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq estado
}

assert {
  res.body.errors[0].permitidos[0]: eq EN_USO
}
