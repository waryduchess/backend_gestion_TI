meta {
  name: Crear activo con responsable inexistente
  type: http
  seq: 14
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/activos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipo": "Laptop",
    "responsableId": "ZZZZ99"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El usuario responsable no existe
}

assert {
  res.body.errors[0].campo: eq responsableId
}
