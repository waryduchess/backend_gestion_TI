meta {
  name: Crear activo sin tipo
  type: http
  seq: 11
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/activos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "marca": "Genius"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}

assert {
  res.body.message: eq Faltan campos obligatorios
}

assert {
  res.body.errors[0].campo: eq tipo
}
