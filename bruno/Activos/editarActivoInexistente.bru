meta {
  name: Editar activo inexistente
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/activos/999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "marca": "Genius"
  }
}

assert {
  res.status: eq 404
}

assert {
  res.body.message: eq Activo no encontrado
}
