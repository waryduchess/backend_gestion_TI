meta {
  name: Cambiar estado id invalido
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/activos/abc/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "EN_USO"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq id
}
