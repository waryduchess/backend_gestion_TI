meta {
  name: Crear ubicacion
  type: http
  seq: 2
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("ubicacionPrueba", `BRU-UBI-${Date.now()}`);
}

post {
  url: {{baseUrl}}/api/ubicaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{ubicacionPrueba}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("ubicacionPruebaId", res.body.data.id);
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.activo: eq true
}
