meta {
  name: Actualizar tipo de usuario
  type: http
  seq: 4
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("tipoUsuarioPruebaEditado", `${bru.getVar("tipoUsuarioPrueba")}-EDITADO`);
}

patch {
  url: {{baseUrl}}/api/tipos-usuario/{{tipoUsuarioPruebaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{tipoUsuarioPruebaEditado}}"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("tipoUsuarioPrueba", res.body.data.nombre);
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.nombre: eq {{tipoUsuarioPruebaEditado}}
}
