meta {
  name: Rechazar asignacion de catalogo inactivo
  type: http
  seq: 10
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "INACTIVO-{{departamentoPruebaId}}",
    "nombre": "Usuario con catalogo inactivo",
    "departamentoId": {{departamentoPruebaId}}
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El catalogo de "departamentoId" no existe o esta inactivo
}
