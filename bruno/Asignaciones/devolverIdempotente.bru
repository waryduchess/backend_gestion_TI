meta {
  name: Devolver equipo ya devuelto
  type: http
  seq: 2
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/asignaciones/{{asignacionId}}/devolucion
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.message: eq Asignacion devuelta correctamente
}

assert {
  res.body.data.estado: eq EN_ALMACEN
}
