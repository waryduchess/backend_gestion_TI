meta {
  name: Editar asignacion ya devuelta
  type: http
  seq: 21
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/asignaciones/{{asignacionCicloId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "observacion": "no permitido"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.message: eq La asignacion ya fue devuelta; no se puede editar
}
