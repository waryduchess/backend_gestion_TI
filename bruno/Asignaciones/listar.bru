meta {
  name: Listar asignaciones
  type: http
  seq: 5
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/asignaciones?page=1&limit=5
  body: json
  auth: none
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body.data) && res.body.data.length > 0) {
    bru.setEnvVar("primerAsignacionId", res.body.data[0].id);
    bru.setEnvVar("totalAsignaciones", res.body.meta.total);
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.success: eq true
}

assert {
  res.body.message: eq Asignaciones obtenidas correctamente
}

assert {
  res.body.meta.page: eq 1
}
