meta {
  name: Editar asignacion inexistente
  type: http
  seq: 16
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/asignaciones/999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "observacion": "x"
  }
}

assert {
  res.status: eq 404
}

assert {
  res.body.message: eq Asignacion no encontrada
}
