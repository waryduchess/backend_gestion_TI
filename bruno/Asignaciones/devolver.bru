meta {
  name: Devolver equipo asignado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/asignaciones/{{asignacionId}}/devolucion
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.success: eq true
}

assert {
  res.body.data.estado: eq EN_ALMACEN
}

assert {
  res.body.data.responsable: eq null
}
