meta {
  name: Listar asignaciones activa invalida
  type: http
  seq: 7
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/asignaciones?activa=BOGUS
  body: json
  auth: none
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El parametro "activa" no tiene un valor valido
}

assert {
  res.body.errors[0].campo: eq activa
}
