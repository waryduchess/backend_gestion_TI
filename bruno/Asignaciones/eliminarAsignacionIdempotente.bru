meta {
  name: Eliminar asignacion ya cerrada
  type: http
  seq: 19
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

delete {
  url: {{baseUrl}}/api/asignaciones/{{asignacionCicloId}}
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.message: eq Asignacion eliminada correctamente
}
