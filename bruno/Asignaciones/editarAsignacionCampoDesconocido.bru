meta {
  name: Editar asignacion con campo no permitido
  type: http
  seq: 13
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/asignaciones/{{asignacionCicloId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuarioId": "A010"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El cuerpo contiene campos no permitidos
}

assert {
  res.body.errors[0].campo: eq campos
}
