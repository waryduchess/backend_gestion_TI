meta {
  name: Crear otra notificacion no leida
  type: http
  seq: 5
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/incidencias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Bruno notificacion para marcar todas",
    "descripcion": "Fixture para validar el marcado masivo.",
    "tipoRequerimiento": "OTROS"
  }
}

assert {
  res.status: eq 201
}
