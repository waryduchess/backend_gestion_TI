meta {
  name: Verificar que no quedan notificaciones no leidas
  type: http
  seq: 7
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/notificaciones?leida=false
  body: json
  auth: none
}

assert {
  res.status: eq 200
  res.body.data: isEmpty
  res.body.meta.noLeidas: eq 0
}
