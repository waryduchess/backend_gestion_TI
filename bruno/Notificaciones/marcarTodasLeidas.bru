meta {
  name: Marcar todas las notificaciones propias como leidas
  type: http
  seq: 6
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/notificaciones/leer-todas
  body: json
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.marcadasComoLeidas: isNumber
}
