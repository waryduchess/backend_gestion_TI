meta {
  name: Crear incidencia para probar notificaciones
  type: http
  seq: 1
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("tituloIncidenciaNotificacion", `Bruno notificacion ${Date.now()}`);
}

post {
  url: {{baseUrl}}/api/incidencias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "{{tituloIncidenciaNotificacion}}",
    "descripcion": "Incidencia fixture para comprobar notificaciones persistentes.",
    "tipoRequerimiento": "OTROS"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("incidenciaNotificacionFixtureId", res.body.data.id);
}

assert {
  res.status: eq 201
}
