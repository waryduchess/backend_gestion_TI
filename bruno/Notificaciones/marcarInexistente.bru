meta {
  name: Notificacion inexistente o ajena
  type: http
  seq: 10
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/notificaciones/2147483647/leer
  body: json
  auth: none
}

assert {
  res.status: eq 404
  res.body.message: eq Notificacion no encontrada
}
