meta {
  name: Marcar notificacion propia como leida
  type: http
  seq: 3
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  if (!bru.getEnvVar("notificacionPropiaId")) throw new Error("Ejecuta primero Notificaciones/listar");
}

patch {
  url: {{baseUrl}}/api/notificaciones/{{notificacionPropiaId}}/leer
  body: json
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.leida: eq true
}
