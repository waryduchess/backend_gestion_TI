meta {
  name: Login con password invalida
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "password_incorrecta"
  }
}

assert {
  res.status: eq 401
}
