meta {
  name: Crear secreto cifrado
  type: http
  seq: 1
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("nombreSecretoPrueba", `Secreto Bruno ${Date.now()}`);
  bru.setVar("passwordSecretoPrueba", `Bruno-Synthetic-${Date.now()}!`);
}

post {
  url: {{baseUrl}}/api/secretos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tipo": "Credencial de prueba",
    "proyecto": "Bruno",
    "nombre": "{{nombreSecretoPrueba}}",
    "usuario": "usuario-prueba",
    "password": "{{passwordSecretoPrueba}}",
    "comentario": "Registro de prueba automatizada"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("secretoPruebaId", res.body.data.id);
  if (res.body?.data && "password" in res.body.data) throw new Error("La respuesta expuso el password");
}

assert {
  res.status: eq 201
  res.body.data.nombre: eq {{nombreSecretoPrueba}}
  res.body.data.activo: eq true
}
