meta {
  name: Revelar password y no cachear
  type: http
  seq: 5
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/secretos/{{secretoPruebaId}}/password
  body: json
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.password: eq {{passwordSecretoActualizado}}
}
