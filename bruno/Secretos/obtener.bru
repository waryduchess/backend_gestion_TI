meta {
  name: Obtener metadatos sin password
  type: http
  seq: 3
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/secretos/{{secretoPruebaId}}
  body: json
  auth: none
}

script:post-response {
  if (res.status === 200 && "password" in res.body.data) throw new Error("El detalle expuso el password");
}

assert {
  res.status: eq 200
  res.body.data.id: eq {{secretoPruebaId}}
}
