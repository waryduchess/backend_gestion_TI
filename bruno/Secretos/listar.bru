meta {
  name: Listar metadatos de secretos
  type: http
  seq: 2
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/secretos
  body: json
  auth: none
}

script:post-response {
  if (res.status !== 200) return;
  const secreto = res.body.data.find((item) => item.id === bru.getVar("secretoPruebaId"));
  if (!secreto) throw new Error("No se encontro el secreto de prueba");
  if ("password" in secreto) throw new Error("El listado expuso el password");
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.meta.total: gt 0
}
