meta {
  name: Verificar secreto eliminado definitivamente
  type: http
  seq: 15
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  const secretoId = bru.getVar("secretoHardDeleteId");
  if (typeof secretoId !== "number") throw new Error("No hay secreto eliminado para verificar");
}

get {
  url: {{baseUrl}}/api/secretos/{{secretoHardDeleteId}}
  body: json
  auth: none
}

assert {
  res.status: eq 404
  res.body.success: eq false
}
