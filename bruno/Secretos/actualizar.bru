meta {
  name: Actualizar password cifrado
  type: http
  seq: 4
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("passwordSecretoActualizado", `Bruno-Updated-${Date.now()}!`);
}

patch {
  url: {{baseUrl}}/api/secretos/{{secretoPruebaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{passwordSecretoActualizado}}",
    "comentario": "Password actualizado por prueba"
  }
}

script:post-response {
  if (res.body?.data && "password" in res.body.data) throw new Error("La respuesta expuso el password actualizado");
}

assert {
  res.status: eq 200
  res.body.data.comentario: eq Password actualizado por prueba
}
