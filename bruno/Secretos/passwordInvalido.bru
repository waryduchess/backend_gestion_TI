meta {
  name: No exponer password en error de validacion
  type: http
  seq: 13
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/secretos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": 123456789
  }
}

script:post-response {
  if (JSON.stringify(res.body).includes("123456789")) throw new Error("El error de validacion expuso el valor de password");
}

assert {
  res.status: eq 400
}
