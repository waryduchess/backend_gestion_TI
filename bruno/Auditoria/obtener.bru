meta {
  name: Obtener registro de auditoria
  type: http
  seq: 7
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  if (typeof bru.getVar("audPrimerId") !== "number") throw new Error("No hay id de auditoria capturado por el listado");
}

get {
  url: {{baseUrl}}/api/auditoria/{{audPrimerId}}
  body: json
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: eq {{audPrimerId}}
}
