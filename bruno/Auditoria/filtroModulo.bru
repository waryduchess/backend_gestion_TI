meta {
  name: Filtrar auditoria por modulo y accion
  type: http
  seq: 2
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/auditoria?modulo=SECRETOS&accion=CREAR&limit=50
  body: json
  auth: none
}

script:post-response {
  if (res.status !== 200) return;
  const fuera = res.body.data.find((item) => item.modulo !== "SECRETOS" || item.accion !== "CREAR");
  if (fuera) throw new Error("El filtro devolvio un movimiento que no corresponde");
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isArray
}
