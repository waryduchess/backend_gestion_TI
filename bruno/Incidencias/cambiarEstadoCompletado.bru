meta {
  name: Cambiar estado a COMPLETADO
  type: http
  seq: 14
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/incidencias/{{incidenciaCreadaId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "COMPLETADO"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.estado: eq COMPLETADO
  res.body.data.fechaResolucion: isString
}
