meta {
  name: Crear incidencia con tipo invalido
  type: http
  seq: 9
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/incidencias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Bruno incidencia tipo invalido",
    "descripcion": "Prueba de validacion del tipo de requerimiento.",
    "tipoRequerimiento": "TIPO_INVALIDO"
  }
}

assert {
  res.status: eq 400
  res.body.errors[0].campo: eq tipoRequerimiento
}
