meta {
  name: Editar usuario
  type: http
  seq: 12
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Usuario Editado"
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.message: eq Usuario actualizado correctamente
}

assert {
  res.body.data.nombre: eq Usuario Editado
}
