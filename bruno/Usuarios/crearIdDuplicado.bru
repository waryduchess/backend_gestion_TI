meta {
  name: Crear usuario id duplicado
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "ADMIN",
    "nombre": "Otro Admin"
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.message: eq Ya existe un usuario con ese id
}

assert {
  res.body.errors[0].campo: eq id
}
