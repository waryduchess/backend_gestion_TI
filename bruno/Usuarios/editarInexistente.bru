meta {
  name: Editar usuario inexistente
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/usuarios/ZZZZ99
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Nadie"
  }
}

assert {
  res.status: eq 404
}

assert {
  res.body.message: eq Usuario no encontrado
}
