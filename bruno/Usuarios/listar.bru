meta {
  name: Listar usuarios
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/usuarios?page=1&limit=5
  body: json
  auth: none
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body.data) && res.body.data.length > 0) {
    bru.setEnvVar("primerUsuarioId", res.body.data[0].id);
    bru.setEnvVar("totalUsuarios", res.body.meta.total);
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.success: eq true
}

assert {
  res.body.message: eq Usuarios obtenidos correctamente
}

assert {
  res.body.meta.page: eq 1
}
