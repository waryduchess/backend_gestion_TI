meta {
  name: Editar usuario con password en el body
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "NuevaClave123"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq password
}
