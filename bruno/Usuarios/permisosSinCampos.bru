meta {
  name: Permisos de usuario sin campos
  type: http
  seq: 32
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  const usuarioId = bru.getVar("permisosUsuarioId");
  if (typeof usuarioId !== "string" || usuarioId === "") throw new Error("No hay usuario para la prueba");
}

patch {
  url: {{baseUrl}}/api/usuarios/{{permisosUsuarioId}}/permisos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.success: eq false
}
