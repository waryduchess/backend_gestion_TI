meta {
  name: Usuarios cambiar password requiere JWT
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/api/usuarios/JWT-ANON/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "TestPassword123"
  }
}

assert {
  res.status: eq 401
}
