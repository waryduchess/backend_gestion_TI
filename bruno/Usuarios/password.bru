meta {
  name: Cambiar password de usuario
  type: http
  seq: 16
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "NuevaClave123"
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.message: eq Password actualizado correctamente
}

assert {
  res.body.data.id: eq {{usuarioCreadoId}}
}
