meta {
  name: Crear usuario con password vacio
  type: http
  seq: 9
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  const id = "ZZP" + Date.now();
  bru.setEnvVar("usuarioPasswordVacioId", id);
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{usuarioPasswordVacioId}}",
    "nombre": "Usuario Password",
    "password": ""
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq El campo "password" no puede estar vacio
}
