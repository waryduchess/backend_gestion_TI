meta {
  name: Cambiar password vacio
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": ""
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq password
}
