meta {
  name: Cambiar password de usuario inexistente
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/usuarios/ZZZZ99/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "NuevaClave123"
  }
}

assert {
  res.status: eq 404
}

assert {
  res.body.message: eq Usuario no encontrado
}
