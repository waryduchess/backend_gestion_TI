meta {
  name: Permisos de usuario inexistente
  type: http
  seq: 33
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/usuarios/NOEXISTE/permisos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agregar": ["dashboard:leer"]
  }
}

assert {
  res.status: eq 404
  res.body.success: eq false
}
