meta {
  name: Crear usuario sin nombre
  type: http
  seq: 6
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  const id = "ZZN" + Date.now();
  bru.setEnvVar("usuarioSinNombreId", id);
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{usuarioSinNombreId}}",
    "nombre": ""
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq Faltan campos obligatorios
}

assert {
  res.body.errors[0].campo: eq nombre
}
