meta {
  name: Crear usuario sin nombre
  type: http
  seq: 6
}

script:pre-request {
  const id = "ZZN" + Date.now();
  bru.setEnvVar("usuarioSinNombreId", id);
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{usuarioSinNombreId}}",
    "nombre": ""
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.message: eq Faltan campos obligatorios
}

assert {
  res.body.errors[0].campo: eq nombre
}
