meta {
  name: Eliminar usuario (borrado logico)
  type: http
  seq: 19
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

delete {
  url: {{baseUrl}}/api/usuarios/{{usuarioCreadoId}}
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.message: eq Usuario dado de baja correctamente
}

assert {
  res.body.data.activo: eq false
}
