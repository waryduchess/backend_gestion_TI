meta {
  name: Descargar reporte de inventario en XLSX
  type: http
  seq: 3
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/reportes/inventario-general/descargar?formato=xlsx&estado=EN_USO
  body: none
  auth: none
}

script:post-response {
  const tipo = String(res.headers["content-type"] || "");
  if (!tipo.includes("spreadsheetml")) throw new Error("El XLSX no tiene el Content-Type esperado");
}

assert {
  res.status: eq 200
}
