meta {
  name: Rechazar fechas invertidas en reporte de auditoria
  type: http
  seq: 23
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/reportes/auditoria-periodo/descargar?formato=csv&desde=2026-12-31&hasta=2026-01-01
  body: none
  auth: none
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
