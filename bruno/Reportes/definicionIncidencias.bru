meta {
  name: Definicion de reporte de incidencias
  type: http
  seq: 18
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/reportes/incidencias-periodo
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.codigo: eq incidencias-periodo
}

assert {
  res.body.data.filtros: isArray
}
