meta {
  name: Rechazar cron de programacion invalido
  type: http
  seq: 38
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/reportes/programaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "codigo": "inventario-general",
    "cron": "cron-invalido",
    "destinatarios": ["ti@example.invalid"]
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
