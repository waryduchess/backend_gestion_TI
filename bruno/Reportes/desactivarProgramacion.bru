meta {
  name: Desactivar programacion de reporte
  type: http
  seq: 37
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  if (!bru.getEnvVar("programacionReporteId")) {
    await bru.runRequest("Reportes/crearProgramacion");
  }
}

delete {
  url: {{baseUrl}}/api/reportes/programaciones/{{programacionReporteId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.activo: eq false
}
