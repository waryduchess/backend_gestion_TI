meta {
  name: Consultar estado de generacion
  type: http
  seq: 32
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  if (!bru.getEnvVar("generacionReporteId")) {
    await bru.runRequest("Reportes/crearGeneracion");
  }
}

get {
  url: {{baseUrl}}/api/reportes/generaciones/{{generacionReporteId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.estado: isString
}
