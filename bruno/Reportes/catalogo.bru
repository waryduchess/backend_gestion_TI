meta {
  name: Catalogo de reportes
  type: http
  seq: 1
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/reportes
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data: isArray
}

script:post-response {
  if (!Array.isArray(res.body.data)) throw new Error("El catalogo no es un arreglo");
  if (!res.body.data.some((item) => item.codigo === "inventario-general")) {
    throw new Error("El catalogo no incluye inventario-general");
  }
}

assert {
  res.body.data: isArray
}
