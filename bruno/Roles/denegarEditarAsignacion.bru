meta {
  name: Denegar edicion de asignacion sin permiso
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/asignaciones/1
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Roles/loginUsuarioPrueba");
  const token = bru.getVar("tokenUsuarioRbac");
  if (typeof token !== "string" || token === "") throw new Error("No fue posible iniciar sesion con el rol limitado");
  req.setHeader("Authorization", "Bearer " + token);
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "observacion": "no permitido"
  }
}

assert {
  res.status: eq 403
}
