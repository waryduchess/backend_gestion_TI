meta {
  name: Actualizar rol RBAC de prueba
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/roles/{{rolPruebaId}}
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "permisos": ["activos:leer", "incidencias:leer"]
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.permisos: isArray
}
