meta {
  name: Login usuario de pocos permisos
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{emailUsuarioRbac}}",
    "password": "Rbac-Test-Password-2026"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("tokenUsuarioRbac", res.body.data.token);
}

assert {
  res.status: eq 200
}
