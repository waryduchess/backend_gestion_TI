meta {
  name: Denegar evidencias de mantenimiento sin permiso
  type: http
  seq: 19
}

script:pre-request {
  await bru.runRequest("Roles/loginUsuarioPrueba");
  const token = bru.getVar("tokenUsuarioRbac");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No hay token del usuario RBAC de prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/mantenimiento/1/evidencias
  body: none
  auth: none
}

assert {
  res.status: eq 403
}
