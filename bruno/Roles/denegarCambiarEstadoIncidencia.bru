meta {
  name: Denegar cambio de estado de incidencia sin permiso
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/incidencias/1/estado
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Roles/loginUsuarioPrueba");
  const token = bru.getVar("tokenUsuarioRbac");
  if (typeof token !== "string" || token === "") throw new Error("No fue posible iniciar sesion con el rol limitado");
  req.setHeader("Authorization", "Bearer " + token);
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "EN_CURSO"
  }
}

assert {
  res.status: eq 403
}
