meta {
  name: Crear usuario RBAC de prueba
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/usuarios
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("usuarioRbacId", `RBAC-${Date.now()}`);
  bru.setVar("emailUsuarioRbac", `rbac-${Date.now()}@example.invalid`);
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{usuarioRbacId}}",
    "nombre": "Usuario de prueba RBAC",
    "email": "{{emailUsuarioRbac}}",
    "password": "Rbac-Test-Password-2026"
  }
}

assert {
  res.status: eq 201
}
