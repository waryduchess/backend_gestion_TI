meta {
  name: Permitir lectura segun permiso
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/activos?page=1&limit=1
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Roles/loginUsuarioPrueba");
  const token = bru.getVar("tokenUsuarioRbac");
  if (typeof token !== "string" || token === "") throw new Error("No fue posible iniciar sesion con el rol limitado");
  req.setHeader("Authorization", "Bearer " + token);
}

assert {
  res.status: eq 200
}
