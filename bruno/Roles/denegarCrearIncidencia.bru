meta {
  name: Denegar creacion de incidencia sin permiso
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/incidencias
  body: json
  auth: none
}

script:pre-request {
  await bru.runRequest("Roles/loginUsuarioPrueba");
  const token = bru.getVar("tokenUsuarioRbac");
  if (typeof token !== "string" || token === "") throw new Error("No fue posible iniciar sesion con el rol limitado");
  req.setHeader("Authorization", "Bearer " + token);
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Incidencia RBAC debe rechazarse",
    "descripcion": "Este rol no incluye incidencias:crear.",
    "tipoRequerimiento": "OTROS"
  }
}

assert {
  res.status: eq 403
}
