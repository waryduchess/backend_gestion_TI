meta {
  name: Ver resumen de horas del proyecto
  type: http
  seq: 46
}

script:pre-request {
  await bru.runRequest("Proyectos/crearHoras");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.resumenHoras.totalHoras: eq 2.5
}

assert {
  res.body.data.resumenHoras.totalRegistros: eq 1
}
