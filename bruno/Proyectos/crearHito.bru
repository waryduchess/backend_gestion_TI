meta {
  name: Crear hito de proyecto
  type: http
  seq: 29
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("tituloHito", "Hito Bruno " + Date.now());
  bru.setVar("fechaHito", new Date(Date.now() + 10 * 86400000).toISOString());
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/hitos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "{{tituloHito}}",
    "descripcion": "Hito de prueba de Bruno",
    "fechaPlanificada": "{{fechaHito}}",
    "orden": 1
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("hitoId", res.body.data.id);
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.estado: eq PENDIENTE
}

assert {
  res.body.data.activo: eq true
}
