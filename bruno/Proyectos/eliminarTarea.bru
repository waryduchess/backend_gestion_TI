meta {
  name: Dar de baja tarea y subtareas
  type: http
  seq: 24
}

script:pre-request {
  await bru.runRequest("Proyectos/crearSubtarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

delete {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.activo: eq false
}
