meta {
  name: Rechazar miembro inexistente
  type: http
  seq: 17
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/miembros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuarioId": "NO-EXISTE",
    "rol": "DESARROLLADOR"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
