meta {
  name: Rechazar asignado inexistente
  type: http
  seq: 27
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Tarea con asignado inexistente",
    "asignadoAId": "NO-EXISTE"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
