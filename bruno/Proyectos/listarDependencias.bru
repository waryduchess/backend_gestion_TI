meta {
  name: Listar dependencias de tarea
  type: http
  seq: 37
}

script:pre-request {
  await bru.runRequest("Proyectos/crearDependencia");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaBId}}/dependencias
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.dependeDe: isArray
}

assert {
  res.body.data.dependeDe[0].id: eq {{tareaAId}}
}

assert {
  res.body.data.dependientes: isArray
}
