meta {
  name: Crear subtarea de proyecto
  type: http
  seq: 19
}

script:pre-request {
  await bru.runRequest("Proyectos/crearTarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Subtarea de prueba",
    "parentId": {{tareaId}},
    "asignadoAId": "ADMIN",
    "prioridad": "NORMAL"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("subtareaId", res.body.data.id);
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.parentId: eq {{tareaId}}
}

assert {
  res.body.data.subtareas: isArray
}
