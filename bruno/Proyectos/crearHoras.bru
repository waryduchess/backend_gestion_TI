meta {
  name: Registrar horas de proyecto
  type: http
  seq: 42
}

script:pre-request {
  await bru.runRequest("Proyectos/crearTarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("fechaHoras", new Date().toISOString());
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/horas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tareaId": {{tareaId}},
    "fecha": "{{fechaHoras}}",
    "horas": 2.5,
    "descripcion": "Horas de prueba de Bruno"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("registroHorasId", res.body.data.id);
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.horas: eq 2.5
}

assert {
  res.body.data.usuario.id: eq ADMIN
}
