meta {
  name: Obtener tarea con subtareas
  type: http
  seq: 21
}

script:pre-request {
  await bru.runRequest("Proyectos/crearSubtarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.subtareas: isArray
}

assert {
  res.body.data.subtareas[0].id: eq {{subtareaId}}
}
