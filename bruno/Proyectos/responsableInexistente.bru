meta {
  name: Rechazar proyecto con responsable inexistente
  type: http
  seq: 8
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Proyecto con responsable inexistente",
    "fechaInicio": "2026-11-01T00:00:00.000Z",
    "fechaFinPlanificada": "2027-01-01T00:00:00.000Z",
    "responsableId": "NO-EXISTE"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
