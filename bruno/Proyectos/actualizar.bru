meta {
  name: Actualizar proyecto
  type: http
  seq: 4
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{nombreProyecto}} actualizado",
    "prioridad": "CRITICA",
    "estado": "EN_PROGRESO"
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.estado: eq EN_PROGRESO
}

assert {
  res.body.data.prioridad: eq CRITICA
}

assert {
  res.body.data.activo: eq true
}
