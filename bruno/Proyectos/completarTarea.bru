meta {
  name: Completar tarea
  type: http
  seq: 23
}

script:pre-request {
  await bru.runRequest("Proyectos/crearTarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "COMPLETADA"
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.estado: eq COMPLETADA
}

assert {
  res.body.data.fechaCompletada: isString
}
