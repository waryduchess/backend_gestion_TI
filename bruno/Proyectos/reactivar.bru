meta {
  name: Reactivar proyecto dado de baja
  type: http
  seq: 11
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  await bru.runRequest("Proyectos/eliminar");
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activo": true
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.activo: eq true
}
