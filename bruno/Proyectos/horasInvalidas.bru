meta {
  name: Rechazar horas fuera de rango
  type: http
  seq: 47
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/horas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fecha": "2026-10-21T12:00:00.000Z",
    "horas": 25
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
