meta {
  name: Listar miembros del proyecto
  type: http
  seq: 13
}

script:pre-request {
  await bru.runRequest("Proyectos/agregarMiembro");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/miembros
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data: isArray
}

assert {
  res.body.data[0].usuario.id: eq ADMIN
}

assert {
  res.body.data[0].rol: eq LIDER
}
