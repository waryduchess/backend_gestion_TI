meta {
  name: Rechazar subtarea de subtarea
  type: http
  seq: 26
}

script:pre-request {
  await bru.runRequest("Proyectos/crearSubtarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Subtarea anidada invalida",
    "parentId": {{subtareaId}}
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
