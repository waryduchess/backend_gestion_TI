meta {
  name: Rechazar transicion de estado invalida
  type: http
  seq: 10
}

script:pre-request {
  await bru.runRequest("Proyectos/crear");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "COMPLETADO"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
