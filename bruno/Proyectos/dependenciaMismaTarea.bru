meta {
  name: Rechazar autodependencia
  type: http
  seq: 40
}

script:pre-request {
  await bru.runRequest("Proyectos/crearTarea");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/tareas/{{tareaId}}/dependencias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dependeDeId": {{tareaId}}
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.success: eq false
}
