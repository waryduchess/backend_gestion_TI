meta {
  name: Listar hitos del proyecto
  type: http
  seq: 30
}

script:pre-request {
  await bru.runRequest("Proyectos/crearHito");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/hitos
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data: isArray
}

assert {
  res.body.data[0].id: eq {{hitoId}}
}

assert {
  res.body.data[0].fechaPlanificada: isString
}
