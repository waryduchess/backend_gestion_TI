meta {
  name: Listar horas del proyecto
  type: http
  seq: 43
}

script:pre-request {
  await bru.runRequest("Proyectos/crearHoras");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/proyectos/{{proyectoId}}/horas?page=1&limit=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data: isArray
}

assert {
  res.body.meta.total: gt 0
}

assert {
  res.body.data[0].horas: gt 0
}
