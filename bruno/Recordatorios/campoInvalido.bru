meta {
  name: Recordatorio con campo no permitido
  type: http
  seq: 16
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

post {
  url: {{baseUrl}}/api/recordatorios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "Recordatorio con campo invalido",
    "foo": "bar"
  }
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq campos
}
