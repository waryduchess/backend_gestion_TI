meta {
  name: Listar recordatorios sin fecha
  type: http
  seq: 10
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/recordatorios?sinFecha=true&q={{qRecordatorioSinFecha}}&limit=100
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.meta.total: gt 0
}

assert {
  res.body.data[0].fecha: eq null
}
