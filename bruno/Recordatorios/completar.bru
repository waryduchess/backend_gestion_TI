meta {
  name: Completar recordatorio
  type: http
  seq: 5
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/recordatorios/{{recordatorioId}}/completar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "completado": true
  }
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.completado: eq true
}

assert {
  res.body.data.completadoEn: isString
}
