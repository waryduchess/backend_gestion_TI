meta {
  name: Crear recordatorio
  type: http
  seq: 1
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("tituloRecordatorio", "Recordatorio Bruno " + Date.now());
  bru.setVar("fechaRecordatorio", new Date(Date.now() + 86400000).toISOString());
}

post {
  url: {{baseUrl}}/api/recordatorios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "{{tituloRecordatorio}}",
    "descripcion": "Descripcion de prueba",
    "fecha": "{{fechaRecordatorio}}",
    "prioridad": "ALTA"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("recordatorioId", res.body.data.id);
    bru.setVar("qRecordatorio", encodeURIComponent(bru.getVar("tituloRecordatorio")));
  }
}

assert {
  res.status: eq 201
}

assert {
  res.body.success: eq true
}

assert {
  res.body.data.titulo: eq {{tituloRecordatorio}}
}

assert {
  res.body.data.prioridad: eq ALTA
}

assert {
  res.body.data.completado: eq false
}

assert {
  res.body.data.fecha: isString
}
