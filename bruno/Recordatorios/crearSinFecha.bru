meta {
  name: Crear recordatorio sin fecha
  type: http
  seq: 9
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("tituloRecordatorioSinFecha", "Nota Bruno " + Date.now());
}

post {
  url: {{baseUrl}}/api/recordatorios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "{{tituloRecordatorioSinFecha}}",
    "descripcion": "Nota sin fecha",
    "prioridad": "BAJA"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("recordatorioSinFechaId", res.body.data.id);
    bru.setVar("qRecordatorioSinFecha", encodeURIComponent(bru.getVar("tituloRecordatorioSinFecha")));
  }
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.fecha: eq null
}
