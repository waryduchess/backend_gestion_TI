meta {
  name: Rechazar activo inexistente
  type: http
  seq: 20
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("fechaProgramadaActivoInexistente", new Date(Date.now() - 86400000).toISOString());
}

post {
  url: {{baseUrl}}/api/mantenimiento
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activoId": 999999,
    "tipo": "PREVENTIVO",
    "tecnicoId": "ADMIN",
    "fechaProgramada": "{{fechaProgramadaActivoInexistente}}"
  }
}

assert {
  res.status: eq 404
}

assert {
  res.body.errors[0].campo: eq activoId
}
