meta {
  name: Crear mantenimiento para cancelar
  type: http
  seq: 10
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("fechaProgramadaCancelar", new Date(Date.now() - 86400000).toISOString());
}

post {
  url: {{baseUrl}}/api/mantenimiento
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activoId": {{ultimoActivoId}},
    "tipo": "CORRECTIVO",
    "estado": "PROGRAMADO",
    "prioridad": "BAJA",
    "tecnicoId": "ADMIN",
    "fechaProgramada": "{{fechaProgramadaCancelar}}",
    "descripcion": "Mantenimiento para prueba de cancelacion"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("mantenimientoCancelarId", res.body.data.id);
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.estado: eq PROGRAMADO
}
