meta {
  name: Rechazar cambio de activo en proceso
  type: http
  seq: 12
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

patch {
  url: {{baseUrl}}/api/mantenimiento/{{mantenimientoCancelarId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activoId": 999999
  }
}

assert {
  res.status: eq 409
}

assert {
  res.body.success: eq false
}
