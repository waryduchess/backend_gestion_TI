meta {
  name: Obtener mantenimiento
  type: http
  seq: 3
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/mantenimiento/{{mantenimientoId}}
  body: json
  auth: none
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.id: eq {{mantenimientoId}}
}

assert {
  res.body.data.activo.id: isNumber
}

assert {
  res.body.data.tecnico.id: eq ADMIN
}
