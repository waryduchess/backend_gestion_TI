meta {
  name: Importacion de secretos requiere autenticacion
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/secretos/importaciones/validar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "filas": [
      { "Nombre": "No debe importarse", "Contraseña": "x" }
    ]
  }
}

assert {
  res.status: eq 401
}
