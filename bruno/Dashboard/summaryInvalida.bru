meta {
  name: Resumen del dashboard sucursal invalida
  type: http
  seq: 4
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
}

get {
  url: {{baseUrl}}/api/dashboard/summary?sucursal=BOGUS
  body: json
  auth: none
}

assert {
  res.status: eq 400
}

assert {
  res.body.errors[0].campo: eq sucursal
}
