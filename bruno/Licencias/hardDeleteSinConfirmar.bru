meta {
  name: Hard delete de licencia sin confirmar
  type: http
  seq: 14
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  await bru.runRequest("Licencias/crear");
  const licenciaId = bru.getVar("licenciaPruebaId");
  if (typeof licenciaId !== "number") throw new Error("No se pudo crear la licencia de apoyo");
}

delete {
  url: {{baseUrl}}/api/licencias/{{licenciaPruebaId}}/hard
  body: json
  auth: none
}

assert {
  res.status: eq 400
  res.body.success: eq false
}
