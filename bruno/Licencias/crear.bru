meta {
  name: Crear licencia de prueba
  type: http
  seq: 2
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("softwareLicenciaPrueba", `Licencia Bruno ${Date.now()}`);
  bru.setVar("proveedorLicenciaPrueba", `Proveedor Bruno ${Date.now()}`);
  bru.setVar("fechaVencimientoLicencia", new Date(Date.now() + 90 * 86400000).toISOString().slice(0, 10));
}

post {
  url: {{baseUrl}}/api/licencias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "software": "{{softwareLicenciaPrueba}}",
    "clave": "BRUNO-LICENSE-SECRET-12345",
    "proveedor": "{{proveedorLicenciaPrueba}}",
    "fechaCompra": "2026-01-01",
    "fechaVencimiento": "{{fechaVencimientoLicencia}}",
    "asignadaAId": "ADMIN"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("licenciaPruebaId", res.body.data.id);
  if (res.body?.data && "clave" in res.body.data) throw new Error("La respuesta expuso la clave de licencia");
}

assert {
  res.status: eq 201
}

assert {
  res.body.data.tieneClave: eq true
}

assert {
  res.body.data.activa: eq true
}
