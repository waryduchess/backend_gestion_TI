meta {
  name: Actualizar licencia
  type: http
  seq: 4
}

script:pre-request {
  await bru.runRequest("Auth/login");
  const token = bru.getEnvVar("token");
  if (typeof token !== "string" || token === "" || token === "0") throw new Error("No fue posible iniciar sesion para la prueba");
  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("softwareLicenciaEditada", `${bru.getVar("softwareLicenciaPrueba")} Editada`);
}

patch {
  url: {{baseUrl}}/api/licencias/{{licenciaPruebaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "software": "{{softwareLicenciaEditada}}",
    "clave": "BRUNO-LICENSE-ROTATED-98765",
    "proveedor": "{{proveedorLicenciaPrueba}}",
    "asignadaAId": null
  }
}

script:post-response {
  if (res.status === 200 && "clave" in res.body.data) throw new Error("La respuesta expuso la clave de licencia");
  if (res.status === 200) bru.setVar("softwareLicenciaPrueba", res.body.data.software);
}

assert {
  res.status: eq 200
}

assert {
  res.body.data.software: eq {{softwareLicenciaEditada}}
}

assert {
  res.body.data.tieneClave: eq true
}

assert {
  res.body.data.asignadaA: eq null
}
